DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirecionar default.php da Hostinger para index.php
    RewriteRule ^default\.php$ index.php [L]

    # Bloquear acesso direto a pastas sensíveis na Hostinger
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^cron/ - [F,L]
</IfModule>

# Proteger arquivos SQL, ENV e Markdown
<FilesMatch "\.(sql|env|sqlite|md|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
AddDefaultCharset UTF-8
